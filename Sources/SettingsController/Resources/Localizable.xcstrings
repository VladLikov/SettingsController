    "Your message is still here. You can copy the support address or message.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение сохранено в форме. Вы можете скопировать адрес поддержки или текст сообщения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما زالت رسالتك هنا. يمكنك نسخ عنوان الدعم أو الرسالة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съобщението ви е запазено тук. Можете да копирате адреса за поддръжка или съобщението."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বার্তাটি এখানেই আছে। সহায়তার ঠিকানা বা বার্তাটি কপি করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El missatge continua aquí. Pots copiar l’adreça d’assistència o el missatge."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpráva je stále zde. Můžete zkopírovat adresu podpory nebo zprávu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din besked er stadig her. Du kan kopiere supportadressen eller beskeden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Nachricht ist noch hier. Du kannst die Support-Adresse oder die Nachricht kopieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μήνυμά σας παραμένει εδώ. Μπορείτε να αντιγράψετε τη διεύθυνση υποστήριξης ή το μήνυμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mensaje sigue aquí. Puedes copiar la dirección de soporte o el mensaje."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viestisi on yhä täällä. Voit kopioida tukiosoitteen tai viestin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message est toujours ici. Vous pouvez copier l’adresse d’assistance ou le message."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
