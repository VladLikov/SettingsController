        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପ୍‌ର ବିଭିନ୍ନ କାର୍ଯ୍ୟରେ ହାପ୍ଟିକ୍ ଫିଡ୍‌ବ୍ୟାକ୍ ଯୋଡ଼େ।"
