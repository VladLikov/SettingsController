        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send ଟାପ୍ କରିଲେ, ଆପଣଙ୍କୁ Mail ଆପ୍‌କୁ ପୁନଃନିର୍ଦ୍ଦେଶିତ କରାଯିବ, ଏବଂ ବାର୍ତ୍ତାଟି ଆପଣଙ୍କ ମେଲବକ୍ସରୁ ପଠାଯିବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਭੇਜੋ 'ਤੇ ਟੈਪ ਕਰਨ ਤੋਂ ਬਾਅਦ ਤੁਸੀਂ ਮੇਲ ਐਪ ਵੱਲ ਰੀਡਾਇਰੈਕਟ ਹੋ ਜਾਵੋਗੇ ਅਤੇ ਸੁਨੇਹਾ ਤੁਹਾਡੇ ਮੇਲਬਾਕਸ ਤੋਂ ਭੇਜਿਆ ਜਾਵੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po stuknięciu Wyślij nastąpi przekierowanie do aplikacji Mail, a wiadomość zostanie wysłana z Twojej skrzynki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de tocar em Enviar, você será redirecionado ao app Mail e a mensagem será enviada pela sua conta de e-mail."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de tocar em Enviar, será redirecionado para a app Mail e a mensagem será enviada a partir da sua caixa de correio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După ce atingi Trimite, vei fi redirecționat în aplicația Mail, iar mesajul va fi trimis din căsuța poștală."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После нажатия «Отправить» вы будете перенаправлены в приложение «Почта», и сообщение будет отправлено с Вашего почтового ящика."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po klepnutí na Odoslať budete presmerovaní do aplikácie Mail a správa sa odošle z vašej poštovej schránky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po tapu na Pošlji boste preusmerjeni v aplikacijo Mail, sporočilo pa bo poslano iz vašega predala."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du trycker på Skicka omdirigeras du till Mail-appen och meddelandet skickas från din brevlåda."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அனுப்பு என்பதைத் தட்டியவுடன், நீங்கள் மெயில் செயலிக்கு மாற்றப்படுவீர்கள்; செய்தி உங்கள் அஞ்சற்பெட்டியிலிருந்து அனுப்பப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send‌ను నొక్కిన తర్వాత, మిమ్మల్ని మెయిల్ యాప్‌కు మళ్లిస్తాము; సందేశం మీ మెయిల్‌బాక్స్ నుండి పంపబడుతుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังแตะ Send จะเปลี่ยนไปยังแอปเมลและส่งข้อความจากกล่องจดหมายของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönder'e dokunduktan sonra Posta uygulamasına yönlendirileceksiniz ve ileti posta kutunuzdan gönderilecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після натискання «Надіслати» вас буде перенаправлено до застосунку «Пошта», а повідомлення буде надіслано з вашої поштової скриньки."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارسال پر ٹیپ کرنے کے بعد، آپ کو میل ایپ پر بھیج دیا جائے گا اور پیغام آپ کے میل باکس سے بھیج دیا جائے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi nhấn Gửi, bạn sẽ được chuyển sang ứng dụng Mail và thư sẽ được gửi từ hộp thư của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按“发送”后，将跳转到“邮件”应用，并从你的邮箱发送该消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕點「傳送」後，將跳至「郵件」App，並會從你的信箱寄出訊息。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按「傳送」後，你會轉到「郵件」App，訊息會從你的信箱傳送。"
          }
        }
      }
    },
