    "After tapping Send, a draft opens in your mail app. Review it and send it there.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После нажатия «Отправить» черновик откроется в почтовом приложении. Проверьте его и отправьте оттуда."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الضغط على «إرسال»، تُفتح مسودة في تطبيق البريد. راجعها وأرسلها من هناك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "След натискане на „Изпрати“ в приложението за поща се отваря чернова. Прегледайте я и я изпратете оттам."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাঠান চাপলে আপনার মেইল অ্যাপে একটি খসড়া খুলবে। সেটি দেখে সেখান থেকে পাঠান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En tocar Envia, s’obrirà un esborrany a l’app de correu. Revisa’l i envia’l des d’allà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po klepnutí na Odeslat se v poštovní aplikaci otevře koncept. Zkontrolujte jej a odešlete odtud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du trykker Send, åbnes en kladde i din mailapp. Gennemse den, og send den derfra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Tippen auf Senden wird ein Entwurf in deiner Mail-App geöffnet. Prüfe ihn und sende ihn dort ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφού πατήσετε Αποστολή, θα ανοίξει ένα πρόχειρο στην εφαρμογή αλληλογραφίας. Ελέγξτε το και στείλτε το από εκεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al tocar Enviar, se abrirá un borrador en tu app de correo. Revísalo y envíalo desde allí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun napautat Lähetä, sähköpostisovellukseen avautuu luonnos. Tarkista se ja lähetä se sieltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir touché Envoyer, un brouillon s’ouvre dans votre app de messagerie. Vérifiez-le et envoyez-le depuis cette app."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મોકલો પર ટૅપ કરવાથી તમારી મેઇલ ઍપમાં ડ્રાફ્ટ ખુલશે. તેને તપાસીને ત્યાંથી મોકલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר הקשה על שליחה, תיפתח טיוטה באפליקציית הדואר. יש לבדוק אותה ולשלוח אותה משם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजें पर टैप करने से आपके मेल ऐप में एक ड्राफ़्ट खुलेगा। उसे जाँचकर वहीं से भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon dodira na Pošalji, u aplikaciji za poštu otvorit će se skica. Pregledajte je i pošaljite odande."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Küldés gombra koppintva piszkozat nyílik meg a levelezőappban. Ellenőrizze, és küldje el onnan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah mengetuk Kirim, draf akan terbuka di aplikasi email Anda. Periksa dan kirim dari sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccando Invia si apre una bozza nell’app di posta. Controllala e inviala da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「送信」をタップすると、メールアプリで下書きが開きます。内容を確認し、そのアプリから送信してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Жіберу» түймесін басқанда пошта қолданбасында жоба ашылады. Оны тексеріп, сол жерден жіберіңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಳುಹಿಸು ಟ್ಯಾಪ್ ಮಾಡಿದಾಗ ನಿಮ್ಮ ಮೇಲ್ ಆ್ಯಪ್‌ನಲ್ಲಿ ಕರಡು ತೆರೆಯುತ್ತದೆ. ಅದನ್ನು ಪರಿಶೀಲಿಸಿ ಅಲ್ಲಿಂದ ಕಳುಹಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기를 탭하면 메일 앱에서 초안이 열립니다. 내용을 확인하고 메일 앱에서 전송하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palietus Siųsti, pašto programėlėje atsidarys juodraštis. Peržiūrėkite jį ir išsiųskite iš ten."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അയയ്ക്കുക ടാപ്പ് ചെയ്യുമ്പോൾ മെയിൽ ആപ്പിൽ ഒരു ഡ്രാഫ്റ്റ് തുറക്കും. അത് പരിശോധിച്ച് അവിടെ നിന്ന് അയയ്ക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठवा वर टॅप केल्यावर मेल अॅपमध्ये मसुदा उघडेल. तो तपासून तिथून पाठवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas mengetik Hantar, draf dibuka dalam app mel anda. Semak dan hantarnya dari situ."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du trykker Send, åpnes et utkast i e-postappen. Se gjennom det og send det derfra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je op Verstuur tikt, wordt een concept in je mailapp geopend. Controleer het en verstuur het daar."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପଠାନ୍ତୁ ଟ୍ୟାପ୍ କଲେ ଆପଣଙ୍କ ମେଲ୍ ଆପ୍‌ରେ ଏକ ଡ୍ରାଫ୍ଟ ଖୋଲିବ। ତାହା ଯାଞ୍ଚ କରି ସେଠାରୁ ପଠାନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਭੇਜੋ ਉੱਤੇ ਟੈਪ ਕਰਨ ਨਾਲ ਤੁਹਾਡੀ ਮੇਲ ਐਪ ਵਿੱਚ ਖਰੜਾ ਖੁੱਲ੍ਹੇਗਾ। ਇਸ ਦੀ ਜਾਂਚ ਕਰਕੇ ਉੱਥੋਂ ਭੇਜੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po stuknięciu Wyślij w aplikacji pocztowej otworzy się wersja robocza. Sprawdź ją i wyślij stamtąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao tocar em Enviar, um rascunho será aberto no app de e-mail. Revise-o e envie por lá."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao tocar em Enviar, abre-se um rascunho na aplicação de correio. Reveja-o e envie-o a partir daí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După ce atingeți Trimite, se deschide o ciornă în aplicația de e-mail. Verificați-o și trimiteți-o de acolo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po klepnutí na Odoslať sa v emailovej apke otvorí koncept. Skontrolujte ho a odošlite odtiaľ."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko tapnete Pošlji, se v poštni aplikaciji odpre osnutek. Preglejte ga in pošljite od tam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du trycker på Skicka öppnas ett utkast i din e-postapp. Granska det och skicka det därifrån."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனுப்பு என்பதைத் தட்டினால், மின்னஞ்சல் செயலியில் வரைவு திறக்கும். அதைச் சரிபார்த்து அங்கிருந்து அனுப்பவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పంపు నొక్కితే మీ మెయిల్ యాప్‌లో చిత్తుప్రతి తెరుచుకుంటుంది. దాన్ని తనిఖీ చేసి అక్కడి నుంచి పంపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อแตะส่ง ฉบับร่างจะเปิดในแอปอีเมล โปรดตรวจสอบแล้วส่งจากแอปนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönder’e dokunduğunuzda e-posta uygulamanızda bir taslak açılır. Kontrol edip oradan gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після натискання «Надіслати» чернетка відкриється в поштовій програмі. Перевірте її та надішліть звідти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بھیجیں پر ٹیپ کرنے سے آپ کی میل ایپ میں مسودہ کھلے گا۔ اسے دیکھ کر وہیں سے بھیجیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi chạm Gửi, một bản nháp sẽ mở trong ứng dụng thư. Hãy kiểm tra và gửi từ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“发送”后，草稿将在邮件应用中打开。请检查内容并在那里发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「傳送」後，草稿會在郵件 App 中開啟。請檢查內容並在那裡傳送。"
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "After tapping Send, a draft opens in your mail app. Review it and send it there."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Al tocar Enviar, se abrirá un borrador en tu app de correo. Revísalo y envíalo desde allí."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Al tocar Enviar, se abrirá un borrador en tu app de correo. Revísalo y envíalo desde allí."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「傳送」後，草稿會在郵件 App 中開啟。請檢查內容並在那裡傳送。"
          }
        }
      },
      "comment": "Mail form footer explaining that the external mail app opens a draft and the user sends it there."
    },
