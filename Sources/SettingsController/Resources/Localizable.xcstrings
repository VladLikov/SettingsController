        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'അയക്കുക' തട്ടിയാൽ, നിങ്ങളെ മെയിൽ ആപ്പിലേക്ക് റീഡിറക്റ്റ് ചെയ്യും, സന്ദേശം നിങ്ങളുടെ മെയിൽബോക്സിൽ നിന്ന് അയക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Send\" वर टॅप केल्यावर तुम्हाला मेल अॅपमध्ये नेले जाईल आणि संदेश तुमच्या मेलबॉक्समधून पाठवला जाईल."
