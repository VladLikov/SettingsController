        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍ୱିଚ୍ ଅନ୍ ଥିଲେ, ପ୍ରଣାଳୀର ଦେଖାଭାବ ବ୍ୟବହାର ହେବ।"
