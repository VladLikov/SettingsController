    },
    "Tap User ID to copy. Support may request it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على معرّف المستخدم لنسخه. قد يطلبه فريق الدعم."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докоснете потребителския идентификатор, за да го копирате. Поддръжката може да го поиска."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কপি করতে ব্যবহারকারী আইডিতে ট্যাপ করুন। সাপোর্ট এটি চাইতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca l'ID d'usuari per copiar-lo. L'assistència pot demanar-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím zkopírujete ID uživatele. Podpora si ho může vyžádat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på bruger-id for at kopiere. Support kan bede om det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf die Benutzer-ID, um sie zu kopieren. Der Support kann sie anfordern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε το αναγνωριστικό χρήστη για αντιγραφή. Η υποστήριξη ενδέχεται να το ζητήσει."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the User ID to copy. Support may ask for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el ID de usuario para copiarlo. Es posible que el equipo de soporte lo solicite."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el ID de usuario para copiarlo. El soporte técnico podría solicitarlo."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el ID de usuario para copiarlo. El soporte técnico puede solicitarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioi napauttamalla käyttäjätunnusta. Tuki voi pyytää sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l’ID utilisateur pour le copier. L’assistance peut le demander."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૉપી કરવા માટે યુઝર આઈડી પર ટેપ કરો. સપોર્ટ તેને માંગી શકે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על מזהה המשתמש כדי להעתיק. ייתכן שהתמיכה תבקש אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी करने के लिए यूज़र आईडी पर टैप करें। सपोर्ट इसे मांग सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite ID korisnika za kopiranje. Podrška ga može zatražiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson a felhasználói azonosítóra a másoláshoz. Az ügyfélszolgálat kérheti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ID pengguna untuk menyalin. Dukungan mungkin memintanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca l'ID utente per copiarlo. L'assistenza potrebbe richiederlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーIDをタップするとコピーされます。サポートから求められる場合があります。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пайдаланушы идентификаторын көшіру үшін түртіңіз. Қолдау қызметі оны сұрауы мүмкін."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಾಪಿ ಮಾಡಲು ಬಳಕೆದಾರರ ಐಡಿ ಮೇಲೆ ತಟ್ಟಿರಿ. ಬೆಂಬಲ ತಂಡ ಅದನ್ನು ಕೇಳಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 ID를 탭하면 복사됩니다. 지원팀에서 요청할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėkite naudotojo ID, kad nukopijuotumėte. Techninis palaikymas gali jo paprašyti."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പകർത്താൻ ഉപയോക്തൃ ഐഡിയിൽ തട്ടുക. സപ്പോർട്ട് അത് ആവശ്യപ്പെട്ടേക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी करण्यासाठी वापरकर्ता आयडीवर टॅप करा. सपोर्ट ते मागू शकतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ID Pengguna untuk menyalin. Sokongan mungkin memintanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på bruker-ID for å kopiere. Kundestøtte kan be om den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op gebruikers-ID om te kopiëren. Support kan erom vragen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କପି କରିବାକୁ ଉପଯୋଗକର୍ତ୍ତା ID ଉପରେ ଟାପ୍ କରନ୍ତୁ। ସହାୟତା ଦଳ ଏହା ଅନୁରୋଧ କରିପାରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਾਪੀ ਕਰਨ ਲਈ ਯੂਜ਼ਰ ID 'ਤੇ ਟੈਪ ਕਰੋ. ਸਹਾਇਤਾ ਇਸ ਦੀ ਬੇਨਤੀ ਕਰ ਸਕਦੀ ਹੈ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij identyfikator użytkownika, aby skopiować. Pomoc techniczna może o niego poprosić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no ID do usuário para copiar. O suporte pode solicitá-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no ID do utilizador para copiar. A assistência pode pedi-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge ID-ul utilizatorului pentru a-l copia. Asistența îl poate solicita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на идентификатор пользователя, чтобы скопировать. Служба поддержки может его запросить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na ID používateľa ho skopírujete. Podpora si ho môže vyžiadať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapnite uporabniški ID za kopiranje. Podpora ga lahko zahteva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på användar-ID för att kopiera. Support kan be om det."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயனர் ஐடியை நகலெடுக்க தட்டவும். ஆதரவு குழு அதைப் கோரலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాపీ చేయడానికి వినియోగదారు ID పై ట్యాప్ చేయండి. సపోర్ట్ దీనిని అడగవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะรหัสผู้ใช้เพื่อคัดลอก ฝ่ายสนับสนุนอาจขอรหัสนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalamak için Kullanıcı kimliğine dokunun. Destek bunu isteyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться ідентифікатора користувача, щоб скопіювати. Служба підтримки може його запросити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کاپی کرنے کے لیے یوزر آئی ڈی پر ٹیپ کریں۔ سپورٹ اس کی درخواست کر سکتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào ID người dùng để sao chép. Bộ phận hỗ trợ có thể yêu cầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按用户ID即可复制。支持团队可能会要求提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點使用者 ID 以複製。支援團隊可能會要求提供。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "點按用戶 ID 以複製。支援團隊可能會要求提供。"
          }
        }
      },
      "comment": "Account section footer explaining the explicit copy action."
    },
