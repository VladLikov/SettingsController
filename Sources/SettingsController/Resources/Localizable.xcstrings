    "After tapping Send, you'll be redirected to the Mail app and the message will be sent from your mailbox." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد النقر على إرسال، سيتم نقلك إلى تطبيق Mail وسيتم إرسال الرسالة من صندوق بريدك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "След като натиснете „Изпрати“, ще бъдете пренасочени към приложението Поща и съобщението ще бъде изпратено от вашата пощенска кутия."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send ট্যাপ করার পর আপনাকে Mail অ্যাপে নিয়ে যাওয়া হবে এবং বার্তাটি আপনার মেইলবক্স থেকে পাঠানো হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan toquis Enviar, se't redirigirà a l'app Mail i el missatge s'enviarà des de la teva bústia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po klepnutí na Odeslat budete přesměrováni do aplikace Mail a zpráva bude odeslána z vaší schránky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du trykker på Send, omdirigeres du til Mail-appen, og beskeden sendes fra din postkasse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Tippen auf „Senden“ wirst du zur Mail-App weitergeleitet und die Nachricht wird aus deinem Postfach verschickt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά την επιλογή «Αποστολή», θα μεταβείτε στην εφαρμογή Mail και το μήνυμα θα σταλεί από το γραμματοκιβώτιό σας."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After you tap Send, you'll be redirected to the Mail app, and the message will be sent from your mailbox."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al tocar Enviar, se te redirigirá a la app Mail y el mensaje se enviará desde tu buzón."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de tocar Enviar, se te redirigirá a la app Mail y el mensaje se enviará desde tu buzón."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al tocar Enviar, se abrirá la app Mail y el mensaje se enviará desde tu buzón."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun napautat Lähetä, sinut ohjataan Mail-sovellukseen ja viesti lähetetään postilaatikostasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir touché Envoyer, vous serez redirigé vers l’app Mail et le message sera envoyé depuis votre messagerie."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘મોકલો’ ટેપ કર્યા પછી તમને મેઇલ એપમાં લઈ જવાશે અને સંદેશો તમારા મેલબૉક્સમાંથી મોકલાશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לאחר הקשה על \"שליחה\", תועברו לאפליקציית \"דואר\" וההודעה תישלח מתיבת הדואר שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भेजें पर टैप करने के बाद आपको मेल ऐप पर ले जाया जाएगा और संदेश आपके मेलबॉक्स से भेज दिया जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon dodira na Pošalji bit ćete preusmjereni u aplikaciju Mail, a poruka će se poslati iz vašeg sandučića."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Küldés megérintése után a Mail alkalmazásba irányítunk, és az üzenetet a postafiókodból küldi el a rendszer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah mengetuk Kirim, Anda akan dialihkan ke aplikasi Mail dan pesan akan dikirim dari akun email Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver toccato Invia, verrai reindirizzato all'app Mail e il messaggio verrà inviato dal tuo account di posta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信をタップするとメールAppが開き、メッセージはあなたのメールアカウントから送信されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Жіберу» түймесін түрткеннен кейін сіз «Пошта» қолданбасына бағытталасыз, ал хабарлама пошта жәшігіңізден жіберіледі."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿದ ನಂತರ, ನಿಮಗೆ Mail ಆಪ್‌ಗೆ ಮರುನಿರ್ದೇಶಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಸಂದೇಶ ನಿಮ್ಮ ಮೇಲ್‌ಬಾಕ್ಸ್‌ನಿಂದ ಕಳುಹಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내기를 탭하면 메일 앱으로 이동하며, 메시지는 사용자의 메일함에서 전송됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakstelėję Siųsti būsite nukreipti į Mail programėlę, o laiškas bus išsiųstas iš jūsų pašto dėžutės."
