    "If you want you can help me translate the app to another language." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا أردت، يمكنك مساعدتي في ترجمة التطبيق إلى لغة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud chcete, můžete mi pomoci přeložit aplikaci do jiného jazyka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
