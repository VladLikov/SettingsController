    "Failed to load. Tap to retry.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить. Нажмите, чтобы повторить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحميل. اضغط لإعادة المحاولة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Неуспешно зареждане. Докоснете за нов опит."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লোড করা যায়নি। আবার চেষ্টা করতে ট্যাপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut carregar. Toca per tornar-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načtení se nezdařilo. Klepnutím to zkuste znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke indlæse. Tryk for at prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden fehlgeschlagen. Zum Wiederholen tippen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποτυχία φόρτωσης. Πατήστε για νέα προσπάθεια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar. Toca para reintentar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataaminen epäonnistui. Yritä uudelleen napauttamalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du chargement. Touchez pour réessayer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લોડ થઈ શક્યું નહીં. ફરી પ્રયાસ કરવા ટૅપ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטעינה נכשלה. יש להקיש כדי לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोड नहीं हो सका। दोबारा कोशिश करने के लिए टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Učitavanje nije uspjelo. Dodirnite za ponovni pokušaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A betöltés sikertelen. Koppintson az újrapróbálkozáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal memuat. Ketuk untuk mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caricamento non riuscito. Tocca per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込めませんでした。タップして再試行してください。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жүктеу мүмкін болмады. Қайталау үшін түртіңіз."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲೋಡ್ ಆಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불러오지 못했습니다. 탭하여 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko įkelti. Palieskite ir bandykite dar kartą."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലോഡ് ചെയ്യാനായില്ല. വീണ്ടും ശ്രമിക്കാൻ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लोड करता आले नाही. पुन्हा प्रयत्न करण्यासाठी टॅप करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal dimuatkan. Ketik untuk cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke laste inn. Trykk for å prøve igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden mislukt. Tik om het opnieuw te proberen."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲୋଡ୍ ହୋଇପାରିଲା ନାହିଁ। ପୁଣି ଚେଷ୍ଟା କରିବାକୁ ଟ୍ୟାପ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੋਡ ਨਹੀਂ ਹੋ ਸਕਿਆ। ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰਨ ਲਈ ਟੈਪ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać. Stuknij, aby ponowić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar. Toque para tentar novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar. Toque para tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încărcarea a eșuat. Atingeți pentru a reîncerca."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Načítanie zlyhalo. Klepnutím skúste znova."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nalaganje ni uspelo. Tapnite za ponovni poskus."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte läsa in. Tryck för att försöka igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்ற முடியவில்லை. மீண்டும் முயற்சிக்கத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లోడ్ కాలేదు. మళ్లీ ప్రయత్నించడానికి నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดไม่สำเร็จ แตะเพื่อลองอีกครั้ง"
