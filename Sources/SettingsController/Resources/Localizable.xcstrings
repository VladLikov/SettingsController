    "Adds taptic feedback to various actions in the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف ردود فعل لمسية لإجراءات متعددة في التطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidává haptickou odezvu k různým akcím v aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføjer haptisk feedback til forskellige handlinger i appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt bei verschiedenen Aktionen in der App Taptic-Feedback hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέτει απτική ανάδραση Taptic σε διάφορες ενέργειες στην εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade respuesta háptica a varias acciones de la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää haptista palautetta sovelluksen eri toimintoihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un retour haptique à diverses actions dans l’app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיף משוב הפטי לפעולות שונות באפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप की विभिन्न कार्रवाइयों में टैप्टिक फीडबैक जोड़ता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haptikus visszajelzést ad az alkalmazás különféle műveleteinél."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge feedback aptico a varie azioni nell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ内の各操作に触覚フィードバックを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 다양한 동작에 탭틱 피드백을 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt haptische feedback toe aan verschillende acties in de app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет тактильную отдачу на различные действия в приложении."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridáva haptickú odozvu pri rôznych akciách v aplikácii."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doda haptični odziv različnim dejanjem v aplikaciji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till haptisk återkoppling för olika åtgärder i appen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamadaki çeşitli eylemlere dokunsal geri bildirim ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає тактильний відгук до різних дій у застосунку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为应用中的各种操作添加触觉反馈。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為 App 中的各種操作加入觸覺回饋。"
          }
        }
      }
    },
    "After tapping Send, you'll be redirected to the Mail app and the message will be sent from your mailbox." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد النقر على إرسال، سيتم توجيهك إلى تطبيق البريد وسيتم إرسال الرسالة من صندوق بريدك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po klepnutí na Odeslat budete přesměrováni do aplikace Mail a zpráva bude odeslána z vaší schránky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du trykker på Send, omdirigeres du til Mail, og beskeden sendes fra din postkasse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Tippen auf „Senden“ wirst du zur Mail-App weitergeleitet und die Nachricht wird aus deinem Postfach gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφού πατήσετε Αποστολή, θα μεταφερθείτε στην εφαρμογή Mail και το μήνυμα θα σταλεί από το γραμματοκιβώτιό σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al tocar Enviar, se te redirigirá a la app Mail y el mensaje se enviará desde tu buzón."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun napautat Lähetä, sinut ohjataan Mail-sovellukseen ja viesti lähetetään postilaatikostasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir touché Envoyer, vous serez redirigé vers l’app Mail et le message sera envoyé depuis votre messagerie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לאחר הקשה על \"שלח\", תופנו לאפליקציית \"דואר\" וההודעה תישלח מתיבת הדואר שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भेजें पर टैप करने के बाद आपको मेल ऐप पर ले जाया जाएगा और संदेश आपके मेलबॉक्स से भेज दिया जाएगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Küldés megérintése után a Mail alkalmazás nyílik meg, és az üzenet a postafiókjából kerül elküldésre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver toccato Invia, verrai reindirizzato all'app Mail e il messaggio verrà inviato dalla tua casella di posta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信をタップすると、「メール」Appに移動し、あなたのメールボックスからメッセージが送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘보내기’를 탭하면 Mail 앱으로 이동하며, 메시지는 사용자 사서함에서 전송됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadat je op Verzenden tikt, word je doorgestuurd naar de app Mail en wordt het bericht vanuit je mailbox verzonden."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После нажатия «Отправить» вы будете перенаправлены в приложение «Почта», и сообщение будет отправлено с Вашего почтового ящика."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po klepnutí na „Odoslať“ budete presmerovaní do aplikácie Mail a správa sa odošle z vašej schránky."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko tapnete Pošlji, boste preusmerjeni v aplikacijo Mail in sporočilo bo poslano iz vašega nabiralnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du trycker på Skicka omdirigeras du till Mail och meddelandet skickas från ditt konto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönder'e dokunduktan sonra Mail uygulamasına yönlendirilirsiniz ve ileti posta kutunuzdan gönderilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після натискання «Надіслати» ви будете перенаправлені до застосунку «Пошта», і повідомлення буде надіслано з вашої скриньки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按发送后，将跳转到邮件应用，邮件将从你的邮箱发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輕點「傳送」後，會開啟 Mail，並從你的信箱寄出。"
          }
        }
      }
    },
